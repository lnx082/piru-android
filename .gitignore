.gradle/
build/
local.properties
.idea/
*.iml
.kotlin/

# The plain-JVM modules (:core:model, :core:engine, :core:substance) compile to
# `bin/`, not `build/` — IntelliJ's layout, which is what the Kotlin JVM plugin
# uses. Without this, a compiled copy of every source file gets committed beside
# the source, and `SubstanceReader.kt` appears twice in the tree.
bin/

# Python bytecode from tools/. The scripts get run, and CPython writes a cache
# beside them; it is not source and it is not reproducible across versions.
__pycache__/
*.pyc

# The release signing identity. **Never commit either of these.**
#
# A keystore is the app's identity: whoever holds it can publish an update to
# your app, and losing it means you can never update it again — Play will reject
# an upload signed with a different key. It belongs in a password manager and an
# offline backup, not in a repository, public or private.
keystore.properties
*.jks
*.keystore

# Editor settings are machine-specific here: the toolchain lives off the system
# drive on this machine (see README), and a committed `settings.json` carrying
# those paths would be wrong for anyone else who clones this.
.vscode/

# The substance database is fetched, never tracked — same rule as the iOS repo.
# db/fetch-db.sh verifies it against db/manifest.json's sha256, and both of
# those are tracked; only the 18 MB database itself is not.
db/piru-substances.sqlite

# Built APKs staged for handing to someone. A build artifact — the release one
# carries the signing identity's fingerprint and is not something to version.
dist/
