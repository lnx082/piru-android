    <string name="shell_health_type_heart_rate_detail">Drawn under the effect curves on a session, with a cursor you can move along it.</string>
    <string name="shell_health_type_resting_heart_rate">Resting heart rate</string>
    <string name="shell_health_type_resting_heart_rate_detail">The slow daily baseline. Read alongside a session.</string>
    <string name="shell_health_type_blood_pressure">Blood pressure</string>
    <string name="shell_health_type_blood_pressure_detail">Shown on the session timeline as a bar per reading, where one exists.</string>
    <string name="shell_health_type_workouts">Workouts</string>
    <string name="shell_health_type_workouts_detail">Marks the heart rate during exercise, so a rise from a run is not read as a rise from a dose.</string>
    <string name="shell_health_type_weight">Weight</string>
    <string name="shell_health_type_weight_detail">Scales the dose models. The newest reading is used.</string>
    <string name="shell_health_body_weight">Body weight</string>
    <string name="shell_health_body_weight_detail">Piru scales every dose model by this — how fast a dose is cleared, and how concentrated it is while it is there. A closer number is a closer curve, not a different one.</string>
    <string name="shell_health_weight_source_manual">You entered this. A reading from Health Connect will not replace it.</string>
    <string name="shell_health_weight_source_synced">Read from Health Connect. A number you type replaces it.</string>
    <string name="shell_health_weight_source_estimated">Not set. The model uses a 60 kg reference until you give it one.</string>
    <string name="shell_health_use_reading">Use the reading from Health Connect (%1$.1f kg)</string>
    <string name="shell_health_weight_value">%1$.1f kg</string>
    <string name="shell_health_no_reading_title">If a reading never appears</string>
    <string name="shell_health_no_reading_body">Piru sees only what other apps have written into Health Connect. If your watch syncs to an app that does not write there, nothing Piru does will make those numbers show up — the steps above are what turns them on.</string>
    <string name="shell_health_vitals_title">Show readings on sessions</string>
    <string name="shell_health_vitals_detail">Draw the phone’s heart rate and blood pressure over a session timeline.</string>
    <string name="shell_health_disclaimer">Readings are shown as the other app recorded them. Piru does not verify them. Not medical advice.</string>

    <!--
      The one-time setup in the *band's* app, which is the step that decides a
      reading exists at all. Piru cannot do any of it for the user: the grant is
      the band app's, not ours.
    -->
    <string name="shell_health_source_title">Getting a reading in</string>
    <string name="shell_health_source_lead">Piru never talks to a watch or a band. A reading exists here only once the app that owns it has been told to write into Health Connect — one switch, once, in that app.</string>
    <string name="shell_health_source_xiaomi_detail">Profile → Settings → Sync with the cloud, on. Then Profile → Third-party data → Health, and choose the items to share. A band paired to a mainland-China account does not offer the second step; the region the account is registered in decides that, and no app on the phone can change it.</string>
    <string name="shell_health_source_xiaomi_title">Mi Fitness / Xiaomi Health (小米运动健康)</string>
    <string name="shell_health_source_other">Any other app — Zepp, Huawei Health, Samsung Health — has the same pair of settings under a different name. A scale that writes to Health Connect directly needs no app at all. Anything that shares by exporting a file is not a source: an import is a file, not a health record.</string>

